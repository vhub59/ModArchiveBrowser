<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.8.3</Version>
    <Description>ModArchiveBrowser</Description>
    <PackageProjectUrl>https://github.com/Noevain/ModArchiveBrowser</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="Penumbra.Api" Version="5.15.1" />
  </ItemGroup>

  <!--
    Le projet de tests voit les types internes du plugin. L'alternative aurait ete de rendre
    publics WebClient et ses voisins pour les seuls besoins des tests : une API publique n'est pas
    faite pour cela, et rien d'exterieur ne consomme cet assemblage.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ModArchiveBrowser.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ModArchiveBrowser.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
